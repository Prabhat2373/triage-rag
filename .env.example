DATABASE_URL=postgresql://localhost:5432/rag_triage

# Optional. Enables Gemini in the chat model menu.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Allows redacted workspace incident text to be sent to Google for semantic indexing.
GEMINI_INDEX_INCIDENTS=false

# Optional. Opens a read-only sample workspace without PostgreSQL or sign-in.
DEMO_MODE=false
